NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Google Tag Manager container ID. Only fires when NEXT_PUBLIC_APP_ENV=production
# (see app/layout.tsx) so local/dev traffic never reaches GTM.
NEXT_PUBLIC_GTM_ID=
# Proveedor de optimización de imágenes (ver "Optimización de imágenes" en el README).
# Default: wsrv (gratis, sin cuenta). Para migrar a ImageKit: crear cuenta free,
# tomar el URL-endpoint del dashboard, poner ambas variables y listo — sin
# cambios de código.
NEXT_PUBLIC_IMAGE_PROVIDER=wsrv
# NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/tu_id
