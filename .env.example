NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Key server-side para la Static Maps API (preview de "Ubicación" en el
# detalle de clase — ver lib/maps/staticMap.ts). Sin restricción de HTTP
# referrer (un request server-side no manda Referer, así que una key
# restringida por referrer la rechaza) — crear una key separada en Google
# Cloud restringida solo por API ("Maps Static API") para producción.
# Si se omite, cae a NEXT_PUBLIC_GOOGLE_MAPS_API_KEY (alcanza en dev, donde
# esa key suele no tener restricciones todavía).
GOOGLE_MAPS_STATIC_API_KEY=
# Google Tag Manager container ID. Only fires when NEXT_PUBLIC_APP_ENV=production
# (see app/layout.tsx) so local/dev traffic never reaches GTM.
NEXT_PUBLIC_GTM_ID=
# Proveedor de optimización de imágenes (ver "Optimización de imágenes" en el README).
# Default: wsrv (gratis, sin cuenta). Para migrar a ImageKit: crear cuenta free,
# tomar el URL-endpoint del dashboard, poner ambas variables y listo — sin
# cambios de código.
NEXT_PUBLIC_IMAGE_PROVIDER=imagekit
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/tu_id
