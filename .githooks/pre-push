#!/bin/sh

# ==============================================================================
# Kynea Git Pre-Push Hook
# Bloquea pushes directos a ramas protegidas (main y develop) en local.
# Respaldo local de seguridad complementario a Branch Protection de GitHub.
# ==============================================================================

while read -r local_ref local_oid remote_ref remote_oid
do
  case "$remote_ref" in
    refs/heads/main|refs/heads/develop)
      echo ""
      echo "⛔ [BLOQUEO DE SEGURIDAD] Push directo a '$remote_ref' cancelado."
      echo "----------------------------------------------------------------------"
      echo "   No está permitido hacer push directo a 'main' ni a 'develop'."
      echo "   1. Crea una rama: git checkout -b feature/tu-cambio (o user/tu-usuario)"
      echo "   2. Sube tu rama:  git push -u origin <rama>"
      echo "   3. Abre un Pull Request en GitHub."
      echo "----------------------------------------------------------------------"
      echo "   (En caso de emergencia justificada según HOTFIX.md: git push --no-verify)"
      echo ""
      exit 1
      ;;
  esac
done

exit 0
